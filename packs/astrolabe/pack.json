    "--mn-ink-2": "#b8af9c",
    "--mn-ink-3": "#7a7466",
    "--mn-line": "#3a3426",
    "--mn-line-strong": "#5a4e36",
    "--mn-accent": "#c9a34e",
    "--mn-accent-ink": "#0a0b0e",
    "--mn-focus": "#e3c77d",
    "--mn-denied": "#c8382e",
    "--mn-stale": "#6c675d",
